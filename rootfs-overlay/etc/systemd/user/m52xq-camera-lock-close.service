[Unit]
Description=M52XQ: close GNOME Snapshot (camera) when the screen is locked, unless it records a video
After=graphical-session.target
# only the phone user (the greeter has a graphical session too)
ConditionUser=user

[Service]
ExecStart=/usr/local/bin/m52xq-camera-lock-close
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
