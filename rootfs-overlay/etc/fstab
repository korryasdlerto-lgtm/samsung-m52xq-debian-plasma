# M52XQ Debian test: the root is mounted by the initramfs (loop image /data/rootfs.img or the system partition).
# No LABEL=pmOS_root line: the system partition of the phone has the same label.
proc /proc proc defaults,nofail,x-systemd.device-timeout=5s 0 0
/dev/disk/by-partlabel/userdata /mnt/userdata ext4 noatime,nofail,x-systemd.device-timeout=10s 0 2
