#!/usr/bin/python3
# M52XQ (Debian Plasma Mobile; from the pmOS Phosh в5 service): screenshot with Volume Up + Volume Down pressed together,
# as in the Lomiri port. Plasma Mobile has no such key combination.
# This root service grabs the two volume key devices (pmic_resin = Volume Down, gpio-keys = Volume Up; EVIOCGRAB) and
# - both keys down within CHORD s of each other: screenshot through KWin ScreenShot2 (helper m52xq-screenshot-py) as the
#   user who runs plasmashell, then a white screen flash (m52xq-flash.py) and the shutter sound; the volume does not
#   change, no OSD;
# - one key alone: the press is passed on (after CHORD s, or at once on a short tap) through a uinput keyboard, so the
#   volume keys keep working.
# The file goes to ~/Pictures/Screenshots/Screenshot_YYYYmmdd_HHMMSS.png, owned by that user.
import fcntl
import glob
import os
import pwd
import select
import struct
import subprocess
import threading
import time

KEY_VOLUMEDOWN, KEY_VOLUMEUP = 114, 115
EV_SYN, EV_KEY = 0, 1
EVENT = struct.Struct('qqHHi')
NAMES = ('pmic_resin', 'gpio-keys')
CHORD = 0.2
EVIOCGRAB = 0x40044590
UI_SET_EVBIT, UI_SET_KEYBIT, UI_DEV_CREATE = 0x40045564, 0x40045565, 0x5501
SOUNDS = ('/usr/share/sounds/freedesktop/stereo/screen-capture.oga',
          '/usr/share/sounds/freedesktop/stereo/camera-shutter.oga')


def log(msg):
	print('m52xq-vol-screenshot: ' + msg, flush=True)


def open_devices():
	fds = []
	for ev in sorted(glob.glob('/sys/class/input/event*')):
		try:
			name = open(ev + '/device/name').read().strip()
		except OSError:
			continue
		if name in NAMES:
			fd = os.open('/dev/input/' + os.path.basename(ev), os.O_RDONLY | os.O_NONBLOCK)
			try:
				fcntl.ioctl(fd, EVIOCGRAB, 1)
			except OSError as e:
				log('grab %s failed: %s' % (name, e))
			fds.append(fd)
	return fds


def make_uinput():
	fd = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK)
	fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
	fcntl.ioctl(fd, UI_SET_EVBIT, EV_SYN)
	for key in (KEY_VOLUMEDOWN, KEY_VOLUMEUP):
		fcntl.ioctl(fd, UI_SET_KEYBIT, key)
	# struct uinput_user_dev: name[80], input_id (bustype, vendor, product, version), ff_effects_max, abs*[64] x 4
	dev = struct.pack('80sHHHHi', b'm52xq-volume-keys', 0x19, 0x4d35, 0x0001, 1, 0) + b'\0' * (4 * 64 * 4)
	os.write(fd, dev)
	fcntl.ioctl(fd, UI_DEV_CREATE)
	return fd


def emit(ufd, code, value):
	os.write(ufd, EVENT.pack(0, 0, EV_KEY, code, value) + EVENT.pack(0, 0, EV_SYN, 0, 0))


def session_user():
	for p in glob.glob('/proc/[0-9]*/cmdline'):
		try:
			if open(p, 'rb').read().split(b'\0')[0] == b'/usr/bin/plasmashell':
				return os.stat(os.path.dirname(p)).st_uid
		except OSError:
			pass
	return None


def session_lang():
	# the language of the Plasma session (texts of the notification), from the environment of plasmashell
	for p in glob.glob('/proc/[0-9]*/cmdline'):
		try:
			if open(p, 'rb').read().split(b'\0')[0] == b'/usr/bin/plasmashell':
				for kv in open(os.path.dirname(p) + '/environ', 'rb').read().split(b'\0'):
					if kv.startswith(b'LANG='):
						return kv[5:].decode()
		except OSError:
			pass
	return 'C.UTF-8'


def screenshot():
	uid = session_user()
	if uid is None:
		log('plasmashell is not running, no screenshot')
		return
	pw = pwd.getpwuid(uid)
	lang = session_lang()
	folder = os.path.join(pw.pw_dir, 'Pictures', 'Screenshots')
	path = os.path.join(folder, time.strftime('Screenshot_%Y%m%d_%H%M%S.png'))
	env = {'XDG_RUNTIME_DIR': '/run/user/%d' % uid, 'DBUS_SESSION_BUS_ADDRESS': 'unix:path=/run/user/%d/bus' % uid,
	       'HOME': pw.pw_dir, 'PATH': '/usr/bin:/bin', 'WAYLAND_DISPLAY': 'wayland-1', 'LANG': lang, 'LANGUAGE': lang.split('.')[0]}
	try:
		subprocess.run(['mkdir', '-p', folder], user=uid, group=pw.pw_gid, env=env, timeout=10, check=True)
		r = subprocess.run(['/usr/local/bin/m52xq-screenshot-py', '/usr/local/share/m52xq/m52xq-screenshot.py', path, '--notify'],
		                   user=uid, group=pw.pw_gid, env=env, timeout=30, capture_output=True, text=True)
		log('screenshot %s: %s' % (path, (r.stdout or r.stderr).strip()))
		if r.returncode != 0:
			return
	except (OSError, subprocess.SubprocessError) as e:
		log('screenshot failed: %s' % e)
		return
	# feedback after the picture is taken (the flash must not be in it)
	sound = next((s for s in SOUNDS if os.path.exists(s)), None)
	if sound:
		try:
			subprocess.Popen(['pw-play', sound], user=uid, group=pw.pw_gid, env=env,
			                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
		except OSError as e:
			log('sound failed: %s' % e)
	try:
		subprocess.Popen(['python3', '/usr/local/share/m52xq/m52xq-flash.py'], user=uid, group=pw.pw_gid, env=env,
		                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	except OSError as e:
		log('flash failed: %s' % e)


def main():
	fds = open_devices()
	if len(fds) < 2:
		log('volume key devices not found (%d of 2)' % len(fds))
	ufd = make_uinput()
	pending = None		# (code, time) of a press that may still become a chord
	passed = set()		# keys whose press went to uinput
	chord = set()		# keys of the current chord, swallowed until released
	while True:
		timeout = None
		if pending:
			timeout = max(0.0, pending[1] + CHORD - time.monotonic())
		ready, _, _ = select.select(fds, [], [], timeout)
		now = time.monotonic()
		if pending and now >= pending[1] + CHORD:
			emit(ufd, pending[0], 1)
			passed.add(pending[0])
			pending = None
		for fd in ready:
			try:
				data = os.read(fd, EVENT.size * 64)
			except BlockingIOError:
				continue
			for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
				_, _, etype, code, value = EVENT.unpack_from(data, off)
				if etype != EV_KEY or code not in (KEY_VOLUMEDOWN, KEY_VOLUMEUP):
					continue
				if value == 1:		# press
					if chord:
						chord.add(code)
					elif pending and pending[0] != code:
						chord = {pending[0], code}
						pending = None
						threading.Thread(target=screenshot, daemon=True).start()
					elif code in passed:
						emit(ufd, code, 1)
					else:
						pending = (code, now)
				elif value == 2:	# autorepeat
					if code in passed:
						emit(ufd, code, 2)
				else:			# release
					if code in chord:
						chord.discard(code)
					elif pending and pending[0] == code:
						emit(ufd, code, 1)	# short tap: pass it on at once
						emit(ufd, code, 0)
						pending = None
					elif code in passed:
						emit(ufd, code, 0)
						passed.discard(code)


main()
